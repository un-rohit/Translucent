<Window x:Class="InvisibleChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleChat"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Invisible AI Chat"
        Height="640" Width="480"
        MinHeight="420" MinWidth="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Arrow"
        Topmost="{Binding Topmost, Mode=TwoWay}"
        Opacity="{Binding WindowOpacity}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="9" Background="#3E3E42" BorderThickness="0"/>
                            <Ellipse x:Name="Thumb" Fill="White" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Trans" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Trans" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Trans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Browser Tab List Style definition -->
        <Style x:Key="BrowserTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="13" Background="Transparent" Padding="14,5" Margin="4,4,4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter TargetName="border" Property="Background" Value="#252528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Tab Button Style -->
        <Style x:Key="TabButtonActive" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="13" Background="{StaticResource PrimaryAccent}" Padding="14,5" Margin="4,4,4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar ListBox Style -->
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Sidebar Item Style -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                <Button Grid.Column="1" x:Name="DelBtn" Style="{StaticResource IconButton}"
                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="18" Height="18" Padding="2" Margin="4,0,0,0"
                                        Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252528"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter TargetName="DelBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E20"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter TargetName="DelBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat Messages ListBox Style -->
        <Style x:Key="ChatListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <!-- Root border with rounded corners -->
    <Border CornerRadius="8" Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════ TITLE BAR ═══════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Title Bar Buttons (Hamburger + Sidebar Toggle) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0">
                        <!-- Hamburger / Mode Switcher -->
                        <Button x:Name="HamburgerBtn" Style="{StaticResource IconButton}"
                                Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Choose Mode"
                                Click="HamburgerBtn_Click">
                            <Path Data="M2 3h12v1.5H2V3zm0 4h12v1.5H2V7zm0 4h12v1.5H2V11z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ModeContextMenu">
                                    <MenuItem x:Name="ChatMenuItem" Header="Chat" Click="ChatTabBtn_Click" IsChecked="True"/>
                                    <MenuItem x:Name="BrowserMenuItem" Header="Browser" Click="BrowserTabBtn_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Sidebar Toggle (visible/enabled only when Chat is active) -->
                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Toggle Sidebar">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 16H5V5h7v14z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Title + Badge (Visible in Chat mode) -->
                    <StackPanel Grid.Column="1" x:Name="TitlePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0" Visibility="Visible">
                        <TextBlock Text="Invisible Chat" Foreground="{StaticResource TextMain}"
                                   FontWeight="Bold" FontSize="13"/>
                        <Border Background="#153E15" BorderBrush="#258E25" BorderThickness="1"
                                CornerRadius="3" Padding="4,1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PROTECTED" Foreground="#44FF44" FontSize="8.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Browser Tabs in Title Bar (Visible in Browser mode) -->
                    <Grid Grid.Column="1" x:Name="TitleTabsPanel" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,-1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Tabs list -->
                        <ListBox x:Name="BrowserTabsList" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource BrowserTabItemStyle}"
                                 SelectionChanged="BrowserTabsList_SelectionChanged"
                                 WindowChrome.IsHitTestVisibleInChrome="True"
                                 VerticalAlignment="Bottom">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder" Background="#202022" CornerRadius="4,4,0,0" 
                                            Padding="10,5" Margin="2,0" MinWidth="90" MaxWidth="150" Height="28">
                                        <Border.ContextMenu>
                                            <ContextMenu Opened="TabContextMenu_Opened">
                                                <MenuItem Header="Mute site" Click="MuteSite_Click"/>
                                                <MenuItem Header="Duplicate" Click="DuplicateTab_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Exit tab" Click="ExitTab_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TabTitleText" Grid.Column="0" Text="{Binding Title}" Foreground="#8A8A8C" 
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Click="CloseTabBtn_Click" Tag="{Binding}" 
                                                    Style="{StaticResource IconButton}" Width="14" Height="14" Padding="1" 
                                                    VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                                <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="#8A8A8C" StrokeThickness="1.2" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1E1E20"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccent}"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0"/>
                                            <Setter TargetName="TabTitleText" Property="Foreground" Value="{StaticResource TextMain}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#2A2A2D"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add Tab Button -->
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" 
                                Width="26" Height="26" Click="NewTabBtn_Click" ToolTip="New Tab (Ctrl+T)" 
                                Margin="4,0,4,2" VerticalAlignment="Bottom"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M5,0 L5,10 M0,5 L10,5" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </Grid>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <!-- Live Captions Sidebar Toggle -->
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ToggleCaptionsSidebarCommand}"
                                Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Live Captions (CC)">
                            <!-- Closed Caption icon path -->
                            <Path Data="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 7H9.5v-.5h-2v3h2V13H11v1c0 .55-.45 1-1 1H6c-.55 0-1-.45-1-1V9c0-.55.45-1 1-1h4c.55 0 1 .45 1 1v2zm7 0h-1.5v-.5h-2v3h2V13H18v1c0 .55-.45 1-1 1h-4c-.55 0-1-.45-1-1V9c0-.55.45-1 1-1h4c.55 0 1 .45 1 1v2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ToggleSettingsCommand}"
                                Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings">
                            <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MinimizeBtn" Style="{StaticResource IconButton}"
                                Click="MinimizeBtn_Click" Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize to Tray">
                            <Path Data="M0,6 L10,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}"
                                Click="CloseBtn_Click" Width="32" Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Exit">
                            <Path Data="M0,0 L10,10 M0,10 L10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ═══════════════════════ CONTENT AREA ═══════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Chat or Browser Panels -->
                <Grid Grid.Column="0">
                    <!-- ─── CHAT PANEL ─── -->
                    <Grid x:Name="ChatPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar -->
                        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                                Width="170"
                                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding Sessions}"
                                         SelectedItem="{Binding SelectedSession}"
                                         Style="{StaticResource SidebarListBoxStyle}"
                                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"/>
                                <Button Grid.Row="1" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding NewSessionCommand}"
                                        Margin="8,6" Padding="8,7" HorizontalAlignment="Stretch"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="＋" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="New Chat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Chat Messages + Input -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" x:Name="MessagesScrollViewer"
                                          Style="{StaticResource ModernScrollViewer}" Padding="0,8">
                                <ListBox ItemsSource="{Binding CurrentMessages}" Style="{StaticResource ChatListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Outer container gives room for the floating copy button -->
                                            <Grid x:Name="MsgGrid" HorizontalAlignment="Left" Margin="0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Copy button row -->
                                                    <RowDefinition Height="Auto"/> <!-- Bubble row      -->
                                                </Grid.RowDefinitions>

                                                <!-- ── Copy button (appears above bubble on hover) ── -->
                                                <Button x:Name="CopyBtn"
                                                        Grid.Row="0"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,2,2"
                                                        Style="{StaticResource IconButton}"
                                                        Padding="4" Width="24" Height="22"
                                                        Visibility="Collapsed"
                                                        Tag="{Binding Content}"
                                                        Click="CopyMessageBtn_Click"
                                                        ToolTip="Copy message"
                                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                                    <!-- Clipboard icon -->
                                                    <Path Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.4" Fill="Transparent"
                                                          Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>

                                                <!-- ── Message bubble ── -->
                                                <Border x:Name="Bubble"
                                                        Grid.Row="1"
                                                        CornerRadius="10,10,10,3"
                                                        Background="#252528"
                                                        Padding="10,8" MaxWidth="270">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Content}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#F0F0F0"
                                                                   FontSize="12.5" LineHeight="18"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}"
                                                                   FontSize="8" Foreground="{StaticResource TextMuted}"
                                                                   Margin="0,3,-2,-2" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <!-- Show copy button on hover -->
                                                <Trigger SourceName="MsgGrid" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CopyBtn" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- User messages: align right, purple bubble, mirrored corners -->
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter TargetName="MsgGrid"  Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="Bubble"   Property="Background"          Value="{StaticResource PrimaryAccent}"/>
                                                    <Setter TargetName="Bubble"   Property="CornerRadius"        Value="10,10,3,10"/>
                                                    <Setter TargetName="CopyBtn"  Property="HorizontalAlignment" Value="Left"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>

                            <!-- "AI is thinking..." indicator -->
                            <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                    Margin="12,0,0,6" Background="#1A1A1C" CornerRadius="8" Padding="10,6"
                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="● ● ●" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Input Bar -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="8" Background="{StaticResource WindowBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="InputTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Tag="Ask Gemini anything... (Enter to send)"
                                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MaxHeight="90"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                             WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButton}"
                                            Command="{Binding SendMessageCommand}"
                                            Width="36" Height="36" Margin="7,0,0,0" VerticalAlignment="Bottom"
                                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Send (Enter)">
                                        <Path Data="M2 12L22 2 12 22 10 13z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ─── BROWSER PANEL ─── -->
                    <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Address bar -->
                            <RowDefinition Height="Auto"/>  <!-- Bookmarks/Shortcuts Bar -->
                            <RowDefinition Height="*"/>     <!-- Dynamic Tab Host Container -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Address Bar -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Back -->
                                    <ColumnDefinition Width="Auto"/> <!-- Forward -->
                                    <ColumnDefinition Width="Auto"/> <!-- Refresh -->
                                    <ColumnDefinition Width="Auto"/> <!-- Home -->
                                    <ColumnDefinition Width="Auto"/> <!-- Lock/Info -->
                                    <ColumnDefinition Width="*"/>    <!-- URL Bar -->
                                    <ColumnDefinition Width="Auto"/> <!-- Go -->
                                </Grid.ColumnDefinitions>

                                <!-- Back -->
                                <Button Grid.Column="0" x:Name="BrowserBackBtn"
                                        Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="BrowserBackBtn_Click" IsEnabled="False"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Back (Alt+Left)">
                                    <Path Data="M15 18L9 12 15 6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Fill="Transparent"/>
                                </Button>

                                <!-- Forward -->
                                <Button Grid.Column="1" x:Name="BrowserForwardBtn"
                                        Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="BrowserForwardBtn_Click" IsEnabled="False"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Forward (Alt+Right)">
                                    <Path Data="M9 18L15 12 9 6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Fill="Transparent"/>
                                </Button>

                                <!-- Refresh -->
                                <Button Grid.Column="2" x:Name="BrowserRefreshBtn"
                                        Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="BrowserRefreshBtn_Click"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Refresh (F5)">
                                    <Path Data="M17.65 6.35A7.958 7.958 0 0012 4C7.58 4 4 7.58 4 12s3.58 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- Home -->
                                <Button Grid.Column="3" x:Name="BrowserHomeBtn"
                                        Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="BrowserHomeBtn_Click"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Home (google.com)">
                                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- Lock/Site Info -->
                                <Button Grid.Column="4" x:Name="SiteInfoBtn"
                                        Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="SiteInfoBtn_Click" Margin="2,0"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Site Information">
                                    <Path x:Name="SiteInfoBtnIcon" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                          Fill="#8A8A8C" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>

                                <!-- URL / Search Bar -->
                                <TextBox Grid.Column="5" x:Name="BrowserUrlBar"
                                         Style="{StaticResource ModernTextBox}"
                                         Tag="Search Google or type a URL..."
                                         Padding="8,6" FontSize="12.5"
                                         KeyDown="BrowserUrlBar_KeyDown"
                                         WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Go Button -->
                                <Button Grid.Column="6" x:Name="BrowserGoBtn"
                                        Style="{StaticResource ModernButton}"
                                        Width="34" Height="30" Margin="5,0,0,0" Padding="0"
                                        Click="BrowserGoBtn_Click"
                                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Go">
                                    <Path Data="M5 12h14M12 5l7 7-7 7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Row 1: Bookmarks/Shortcuts Bar -->
                        <Border x:Name="BookmarksBar" Grid.Row="1" Background="#18181A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <!-- Sleek pill bookmark style -->
                                    <Style x:Key="BookmarkPill" TargetType="Button">
                                        <Setter Property="Background" Value="#202022"/>
                                        <Setter Property="Foreground" Value="#D0D0D2"/>
                                        <Setter Property="Padding" Value="10,3"/>
                                        <Setter Property="FontSize" Value="10.5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Height" Value="22"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2D2D30"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>
                                
                                <TextBlock Text="Shortcuts:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                
                                <!-- Google -->
                                <Button Content="Google" Click="ShortcutBtn_Click" Tag="https://www.google.com" Style="{StaticResource BookmarkPill}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                
                                <!-- ChatGPT -->
                                <Button Content="ChatGPT" Click="ShortcutBtn_Click" Tag="https://chatgpt.com" Style="{StaticResource BookmarkPill}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                
                                <!-- Gemini -->
                                <Button Content="Gemini" Click="ShortcutBtn_Click" Tag="https://gemini.google.com" Style="{StaticResource BookmarkPill}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                
                                <!-- Claude -->
                                <Button Content="Claude" Click="ShortcutBtn_Click" Tag="https://claude.ai" Style="{StaticResource BookmarkPill}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 2: Dynamic Tab Host Container -->
                        <Grid Grid.Row="2" x:Name="BrowserTabsContainer"/>

                        <!-- Popup for Site Info / Permissions -->
                        <Popup x:Name="SiteInfoPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=SiteInfoBtn}" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1C1C1F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Width="280">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Domain Title -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PopupDomainText" Text="google.com" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="18" Height="18" Padding="2" Click="CloseSiteInfo_Click">
                                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <!-- Connection Status -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="PopupSecurityIcon" Grid.Column="0" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                                  Fill="#44FF44" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="PopupSecurityText" Grid.Column="1" Text="Connection is secure" Foreground="#A0A0A5" FontSize="12.5" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Permissions List -->
                                    <TextBlock Text="Permissions" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"/>
                                    
                                    <!-- Location Permission Row -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" 
                                              Fill="#A0A0A5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="Location" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="2" x:Name="LocationPermissionToggle" Style="{StaticResource ToggleSwitchStyle}" Checked="PermissionToggle_Changed" Unchecked="PermissionToggle_Changed"/>
                                    </Grid>

                                    <!-- Microphone Permission Row -->
                                    <Grid Margin="0,4,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.42 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z" 
                                              Fill="#A0A0A5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="Microphone" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="2" x:Name="MicrophonePermissionToggle" Style="{StaticResource ToggleSwitchStyle}" Checked="PermissionToggle_Changed" Unchecked="PermissionToggle_Changed"/>
                                    </Grid>

                                    <!-- Reset Permissions Button -->
                                    <Button Content="Reset permissions" Style="{StaticResource SecondaryButton}" 
                                            HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,12" FontSize="11.5" Height="24" Click="ResetPermissions_Click"/>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>

                                    <!-- Cookies and Site Data Row -->
                                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Stretch" Padding="0,4" Margin="0,2" Click="ClearSiteData_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10c0-5.52-4.48-10-10-10zm-3.5 6c.83 0 1.5-.67 1.5-1.5S9.33 5 8.5 5 7 5.67 7 6.5 7.67 8 8.5 8zm-2 7c.83 0 1.5-.67 1.5-1.5S7.33 12 6.5 12 5 12.67 5 13.5 5.67 15 6.5 15zm8 3c.83 0 1.5-.67 1.5-1.5S15.33 15 14.5 15s-1.5.67-1.5 1.5.67 1.5 1.5 1.5zm0-10c.83 0 1.5-.67 1.5-1.5S15.33 5 14.5 5s-1.5.67-1.5 1.5.67 1.5 1.5 1.5zm-3 5.5c.83 0 1.5-.67 1.5-1.5S10.33 9 9.5 9 8 9.67 8 10.5s.67 1.5 1.5 1.5z" 
                                                  Fill="#A0A0A5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Cookies and site data" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                                            <Path Grid.Column="2" Data="M8 5v14l11-7z" Fill="#8A8A8C" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <!-- Right Column: Live Captions Sidebar -->
                <Border Grid.Column="1" Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        Width="280"
                        Visibility="{Binding IsCaptionsSidebarVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title Bar -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Captions List -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Controls -->
                        </Grid.RowDefinitions>

                        <!-- Sidebar Title -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎤 Live Captions" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding ToggleCaptionsSidebarCommand}" Style="{StaticResource IconButton}" Width="20" Height="20" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close Sidebar">
                                    <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="8" Height="8"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Captions List -->
                        <ScrollViewer Grid.Row="1" x:Name="CaptionsScrollViewer" Style="{StaticResource ModernScrollViewer}" Padding="10">
                            <ItemsControl ItemsSource="{Binding Captions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CaptionCard" Background="#222225" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock x:Name="CaptionText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F0F0F0" FontSize="11.5" LineHeight="16"/>
                                                    <TextBlock Text="{Binding Timestamp}" FontSize="8" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <!-- Copy Button -->
                                                <Button Grid.Column="1" Click="CopyCaptionBtn_Click" Tag="{Binding Text}" Style="{StaticResource IconButton}" Width="20" Height="20" Padding="3" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Copy Caption">
                                                    <Path Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                <Setter TargetName="CaptionCard" Property="Background" Value="#1C2E1C"/>
                                                <Setter TargetName="CaptionCard" Property="BorderBrush" Value="#2E5C2E"/>
                                                <Setter TargetName="CaptionText" Property="Foreground" Value="#8AE28A"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bottom Controls (On/Off Toggle, Clear) -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10" Background="{StaticResource HeaderBg}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ToggleCaptionsBtn" Click="ToggleCaptionsBtn_Click" Style="{StaticResource ModernButton}" Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <TextBlock x:Name="ToggleCaptionsBtnText" Text="Turn On" FontWeight="Bold" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding ClearCaptionsCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Content="Clear" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════ SETTINGS OVERLAY ═══════════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Background="#DD0C0C0E"
                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E1E20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Width="320" Height="430"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="⚙ Settings" Foreground="{StaticResource TextMain}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}"
                                      Margin="0,0,-8,0" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Gemini API Key" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="Paste your Gemini API key..."
                                         Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Text="API Endpoint" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="https://generativelanguage.googleapis.com/v1beta"
                                         Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Text="Model Name" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="gemini-3.7-flash"
                                         Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Text="System Prompt" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="System Instructions..."
                                         Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Height="55" AcceptsReturn="True" TextWrapping="Wrap"
                                         Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Window Opacity"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"
                                               Foreground="{StaticResource TextMain}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="0.30" Maximum="1.0"
                                        Value="{Binding WindowOpacity, Mode=TwoWay}"
                                        SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                                        Margin="0,0,0,14" WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <CheckBox IsChecked="{Binding Topmost, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,0,4"
                                          WindowChrome.IsHitTestVisibleInChrome="True">
                                    <TextBlock Text="Always on top" Foreground="{StaticResource TextMain}"
                                               FontSize="12" Margin="5,0,0,0"/>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                    Content="Cancel" Command="{Binding ToggleSettingsCommand}"
                                    Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Grid.Column="1" Style="{StaticResource ModernButton}"
                                    Content="Save" Command="{Binding SaveSettingsCommand}"
                                    Margin="5,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
