<Window x:Class="InvisibleChat.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#15000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas">
        <!-- Top Hint Pill -->
        <Border Background="#CC1E1E22" CornerRadius="14" Padding="14,6" Canvas.Top="20"
                BorderBrush="#8E2DE2" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Canvas.Left" Value="40"/>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✂️ Drag to Snip Region for AI" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5"/>
                <TextBlock Text="  •  Esc to Cancel" Foreground="#AAAAAA" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Selection Rectangle -->
        <Border x:Name="SelectionBox"
                BorderBrush="#A044EE"
                BorderThickness="2"
                Background="#25A044EE"
                CornerRadius="2"
                Visibility="Collapsed">
            <Border Background="#DD121214" CornerRadius="4" Padding="6,2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                <TextBlock x:Name="DimensionText" Text="0 × 0" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
            </Border>
        </Border>
    </Canvas>
</Window>
